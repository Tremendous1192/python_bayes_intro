{
    // 作成日: 2026-09-26
    // 目的・役割: このフォルダの編集環境を、uv管理のNotebook実行に揃える。
    // 使用方法: open_vscode.cmdから開き、Notebook側でも同じPythonを選択する。
    // 制約: marimo拡張機能0.18.1、Windowsの固定配置。依存変更はuvで行う。
    // 非対応: sandbox環境、セルからの依存追加、他プロジェクトへの設定適用。
    "terminal.integrated.defaultProfile.windows": "Command Prompt",
    "python.defaultInterpreterPath": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
    // uvが実行系を選ぶため、ターミナルの暗黙のactivateは使わない。
    "python.terminal.activateEnvironment": false,
    // 拡張機能のパッケージ導入案内を無効にし、依存の原本を一本化する。
    "marimo.disableUvIntegration": true,
    // Notebookの配置によってデータや出力の基準ディレクトリを変えない。
    "marimo.notebookFileRoot": "${workspaceFolder}"
}
